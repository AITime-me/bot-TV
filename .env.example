BOT_MODE=OFF
EMERGENCY_LOCK=true

# Optional Bot Core PostgreSQL (not required for BOT_MODE=OFF health startup).
# Use the async SQLAlchemy URL form in runtime code:
# DATABASE_URL=postgresql+asyncpg://bot:password@127.0.0.1:5432/bot_tv
DATABASE_URL=

# Manager handoff: configurable 10–15 minute pause and 1–60 second due scan.
HANDOFF_PAUSE_SECONDS=900
HANDOFF_EXPIRY_POLL_SECONDS=1

# Continuous worker runtime. Heartbeat stale window must remain larger than
# both the tick timeout and twice the longest poll/heartbeat interval.
WORKER_POLL_SECONDS=1
WORKER_BATCH_SIZE=100
WORKER_TICK_TIMEOUT_SECONDS=20
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_STALE_SECONDS=45
WORKER_MAX_CONSECUTIVE_FAILURES=3

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
VK_TOKEN=
MAX_BOT_TOKEN=
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=

# Ephemeral encrypted PII (Stage 2A foundation). Not required for BOT_MODE=OFF.
# Keys are read lazily only when encrypt/decrypt is invoked.
# EPHEMERAL_PII_KEY_<KEY_ID> must be canonical base64url of exactly 32 bytes.
# Do not put real key material in this file.
EPHEMERAL_PII_ACTIVE_KEY_ID=
# EPHEMERAL_PII_KEY_<KEY_ID>=

# Optional booking eligibility S2S client (CURSOR-16/17). Both BASE_URL and
# BEARER_TOKEN must be set together, or both left unset. Partial config fails
# closed at startup. Token must be 32..512 printable ASCII and matches
# online-zapis-tv BOT_INTERNAL_API_TOKEN (never commit a real value).
# Contract: docs/adr/015-booking-eligibility-s2s-contract.md
# BOOKING_ELIGIBILITY_BASE_URL=
# BOOKING_ELIGIBILITY_BEARER_TOKEN=
# BOOKING_ELIGIBILITY_TIMEOUT_SECONDS=5.0
# BOOKING_ELIGIBILITY_MAX_RESPONSE_BYTES=65536

# Attachment spool maintenance process (CURSOR-13 Stage 3A Compose wiring).
# Fail-closed: disabled by default. Compose profile attachment-maintenance is
# also required before the container starts.
# Spool root/TTL are process-local (not shared Settings for api/worker).
# Root must already exist as an absolute directory; the process never mkdir.
# Compose named-volume default container path:
# ATTACHMENT_SPOOL_ROOT=/var/lib/bot-tv/attachment-spool
ATTACHMENT_MAINTENANCE_ENABLED=false
ATTACHMENT_MAINTENANCE_INTERVAL_SECONDS=60
ATTACHMENT_MAINTENANCE_INITIAL_DELAY_SECONDS=0
ATTACHMENT_RECONCILE_BATCH_LIMIT=100
ATTACHMENT_PURGE_BATCH_LIMIT=100
ATTACHMENT_SPOOL_ROOT=/absolute/path/to/attachment-spool
ATTACHMENT_SPOOL_TTL_SECONDS=900
# Host-local keyring env_file path for Compose (non-secret). File stays outside
# Git and must not be printed. Default matches docker-compose.yml.
ATTACHMENT_SPOOL_KEYS_ENV_FILE=/etc/bot-tv/attachment-spool-keys.env
# Attachment keys live only in the external keyring file (not in Compose
# environment mapping). Template only — do not put real key material here:
# ATTACHMENT_SPOOL_ACTIVE_KEY_ID=
# ATTACHMENT_SPOOL_KEY_<KEY_ID>=
