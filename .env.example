BOT_MODE=OFF
EMERGENCY_LOCK=true

# Optional Bot Core PostgreSQL (not required for BOT_MODE=OFF health startup).
# Use the async SQLAlchemy URL form in runtime code:
# DATABASE_URL=postgresql+asyncpg://bot:password@127.0.0.1:5432/bot_tv
DATABASE_URL=

# Manager handoff: configurable 10–15 minute pause and 1–60 second due scan.
HANDOFF_PAUSE_SECONDS=900
HANDOFF_EXPIRY_POLL_SECONDS=1

# Continuous worker runtime. Heartbeat stale window must remain larger than
# both the tick timeout and twice the longest poll/heartbeat interval.
WORKER_POLL_SECONDS=1
WORKER_BATCH_SIZE=100
WORKER_TICK_TIMEOUT_SECONDS=20
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
WORKER_HEARTBEAT_STALE_SECONDS=45
WORKER_MAX_CONSECUTIVE_FAILURES=3

# Teя Yandex GPT provider foundation (default-off). Text generation only —
# never CRM/booking/channel writes. Partial enabled config fails closed.
# Native AI Studio completion: POST /foundationModels/v1/completion
# Auth: Authorization: Api-Key <YANDEX_API_KEY>
# Default model URI: gpt://<YANDEX_FOLDER_ID>/yandexgpt/latest
YANDEX_LLM_ENABLED=false
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# YANDEX_MODEL_URI=
# YANDEX_LLM_API_BASE_URL=https://llm.api.cloud.yandex.net
# YANDEX_LLM_TIMEOUT_SECONDS=15.0
# YANDEX_LLM_MAX_RESPONSE_BYTES=65536
# YANDEX_LLM_TEMPERATURE=0.3
# YANDEX_LLM_MAX_TOKENS=1024
# Legacy unused placeholder (not read by Settings). Prefer VK_MASTER_* below.
VK_TOKEN=
MAX_BOT_TOKEN=

# CURSOR-29 VK master adapter (default-off). Partial sets fail closed.
# Callback config (group+secret+confirmation) required to register the route.
# Business execution also requires ENABLED=true, access token, BOT_MODE!=OFF,
# EMERGENCY_LOCK=false. No live deploy in-repo.
# VK_MASTER_ADAPTER_ENABLED=false
# VK_MASTER_GROUP_ID=
# VK_MASTER_CALLBACK_SECRET=
# VK_MASTER_CONFIRMATION=
# VK_MASTER_ACCESS_TOKEN=
# VK_MASTER_API_VERSION=5.199
# VK_MASTER_API_BASE_URL=https://api.vk.com
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=

# AMO-01B2 CRM REST OAuth (default-off). Completely separate from AMOCRM_CHAT_*.
# Partial/invalid enabled config fails closed (zero CRM HTTP).
# AMOCRM_CRM_REST_ENABLED=false
# AMOCRM_CRM_API_BASE_URL=https://example.amocrm.ru
# Exact OAuth redirect_uri registered in the amoCRM integration (required when REST enabled).
# AMOCRM_CRM_REDIRECT_URI=https://example.com/oauth
# AMOCRM_CRM_CONNECTION_SCOPE=default
# TECHNICAL_DEAL create (default-off). Requires CRM REST + pipeline/status IDs.
# AMOCRM_CRM_DEAL_CREATE_ENABLED=false
# AMOCRM_CRM_DEAL_PIPELINE_ID=
# AMOCRM_CRM_DEAL_STATUS_ID=

# Business «Лиды» writes for Teya request orchestrator (default-off).
# Separate from technical-deal create. No hardcoded account IDs in code.
# AMOCRM_CRM_BUSINESS_WRITE_ENABLED=false
# AMOCRM_CRM_BUSINESS_PIPELINE_ID=
# AMOCRM_CRM_BUSINESS_STATUS_ID=
# AMOCRM_CRM_BUSINESS_MANAGER_ID=
# AMOCRM_CRM_BUSINESS_TASK_TYPE_ID=

# Teya reliability retry / breaker / ops (safe defaults).
# TEYA_RETRY_BASE_SECONDS=30
# TEYA_RETRY_MAX_SECONDS=900
# TEYA_RETRY_JITTER_RATIO=0.2
# TEYA_RETRY_MAX_ATTEMPTS=8
# AMOCRM_BREAKER_FAILURE_THRESHOLD=5
# AMOCRM_BREAKER_COOLDOWN_SECONDS=60
# AMOCRM_BREAKER_HALF_OPEN_SUCCESSES=1
# AMOCRM_BREAKER_PROBE_LEASE_SECONDS=30
# TEYA_OPS_TOKEN=  # min 16 chars; enables GET /internal/teya-ops/snapshot

# Durable OAuth token AEAD keys (lazy; same 32-byte base64url pattern as PII).
# Do not put real key material in this file.
# AMOCRM_CRM_OAUTH_ACTIVE_KEY_ID=
# AMOCRM_CRM_OAUTH_KEY_<KEY_ID>=

# AMO-01A Chat webhook (default-off). Partial enabled config fails closed.
# Requires CHANNEL_SECRET + SCOPE_ID. Route: POST /webhooks/amocrm/chat/{scope_id}
# AMOCRM_CHAT_WEBHOOK_ENABLED=false
# AMOCRM_CHAT_CHANNEL_SECRET=
# AMOCRM_CHAT_SCOPE_ID=

# AMO-01B1 Chat egress: CLIENT_INBOUND + BOT_OUTBOUND projection (default-off).
# BOT_OUTBOUND projects durable outbox payload_json.text after DELIVERED.
# Reuses CHANNEL_SECRET + SCOPE_ID. BOT_OUTBOUND needs AMOCRM_CHAT_BOT_ID
# (registered Chat bot id → sender.ref_id). No OAuth / CRM REST in Chat path.
# AMOCRM_CHAT_EGRESS_ENABLED=false
# AMOCRM_CHAT_API_BASE_URL=https://amojo.amocrm.ru
# AMOCRM_CHAT_BOT_ID=

# Docker: OAuth AEAD key bytes for api/worker come only from optional env_file
# AMOCRM_CRM_OAUTH_KEYS_ENV_FILE (default /etc/bot-tv/amocrm-crm-oauth-keys.env).
# Never put real key material in this file or docker-compose.yml.

# Ephemeral encrypted PII (Stage 2A foundation). Not required for BOT_MODE=OFF.
# Keys are read lazily only when encrypt/decrypt is invoked.
# EPHEMERAL_PII_KEY_<KEY_ID> must be canonical base64url of exactly 32 bytes.
# Do not put real key material in this file.
EPHEMERAL_PII_ACTIVE_KEY_ID=
# EPHEMERAL_PII_KEY_<KEY_ID>=

# Optional booking eligibility S2S client (CURSOR-16/17). Both BASE_URL and
# BEARER_TOKEN must be set together, or both left unset. Partial config fails
# closed at startup. Token must be 32..512 printable ASCII and matches
# online-zapis-tv BOT_INTERNAL_API_TOKEN (never commit a real value).
# Contract: docs/adr/015-booking-eligibility-s2s-contract.md
# BOOKING_ELIGIBILITY_BASE_URL=
# BOOKING_ELIGIBILITY_BEARER_TOKEN=
# BOOKING_ELIGIBILITY_TIMEOUT_SECONDS=5.0
# BOOKING_ELIGIBILITY_MAX_RESPONSE_BYTES=65536
# Shared S2S config for eligibility, availability reads, and booking create
# (POST /api/internal/bot/v1/bookings). No separate create token/URL.

# Attachment spool maintenance process (CURSOR-13 Stage 3A Compose wiring).
# Fail-closed: disabled by default. Compose profile attachment-maintenance is
# also required before the container starts.
# Spool root/TTL are process-local (not shared Settings for api/worker).
# Root must already exist as an absolute directory; the process never mkdir.
# Compose named-volume default container path:
# ATTACHMENT_SPOOL_ROOT=/var/lib/bot-tv/attachment-spool
ATTACHMENT_MAINTENANCE_ENABLED=false
ATTACHMENT_MAINTENANCE_INTERVAL_SECONDS=60
ATTACHMENT_MAINTENANCE_INITIAL_DELAY_SECONDS=0
ATTACHMENT_RECONCILE_BATCH_LIMIT=100
ATTACHMENT_PURGE_BATCH_LIMIT=100
ATTACHMENT_SPOOL_ROOT=/absolute/path/to/attachment-spool
ATTACHMENT_SPOOL_TTL_SECONDS=900
# Host-local keyring env_file path for Compose (non-secret). File stays outside
# Git and must not be printed. Default matches docker-compose.yml.
ATTACHMENT_SPOOL_KEYS_ENV_FILE=/etc/bot-tv/attachment-spool-keys.env
# Attachment keys live only in the external keyring file (not in Compose
# environment mapping). Template only — do not put real key material here:
# ATTACHMENT_SPOOL_ACTIVE_KEY_ID=
# ATTACHMENT_SPOOL_KEY_<KEY_ID>=
